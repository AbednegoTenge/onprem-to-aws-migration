# ---- Web app database (DB_*) ------------------------------------------
# No inline comments: systemd's EnvironmentFile would keep them as part of the value.
# BEFORE cutover: on-prem MySQL
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shopdb
DB_USER=shopapp
DB_PASSWORD=ChangeMe-App-123

# AFTER cutover: RDS PostgreSQL (comment the block above, uncomment this)
# DB_ENGINE=postgres
# DB_HOST=shop-pg.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# the RDS database name, and the schema SCT converts MySQL database `shopdb` into
# DB_NAME=shopdb
# DB_SCHEMA=shopdb
# DB_USER=shopapp
# DB_PASSWORD=ChangeMe-App-123

# true = app refuses writes (maintenance page) even if the DB is writable
APP_READ_ONLY=false
SECRET_KEY=change-this-to-something-random

# ---- tools/verify_migration.py (SRC_* = MySQL source, TGT_* = RDS target)
SRC_ENGINE=mysql
SRC_HOST=127.0.0.1
SRC_PORT=3306
SRC_NAME=shopdb
SRC_USER=shopapp
SRC_PASSWORD=ChangeMe-App-123

TGT_ENGINE=postgres
TGT_HOST=shop-pg.xxxxxxxx.us-east-1.rds.amazonaws.com
TGT_PORT=5432
TGT_NAME=shopdb
TGT_SCHEMA=shopdb
TGT_USER=postgres
TGT_PASSWORD=ChangeMe-Rds-123
